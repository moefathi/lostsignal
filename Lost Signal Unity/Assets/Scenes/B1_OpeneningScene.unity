      m_Calls: []
  m_text: "Alien boss: \"So, the famous Captain John has finally arrived. Eight months
    ago, Captain Emilie entered my world seeking answers. \n\nShe failed my challenges
    and became my prisoner. Now you stand before me with the same goal. If you wish
    to see your friend again, you must prove your worth.\r\n\r\nYou will face three
    trials. Survive them, and I will release Emilie and return your spaceship. Fail,
    and both of you will remain here forever. The choice is yours, Captain. Let the
    first trial begin.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
  m_sharedMaterial: {fileID: 2140032, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
