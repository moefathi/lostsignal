  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "John: \"Emilie! I can't believe it... you're alive. We lost contact with
    you eight months ago. Everyone thought the mission was gone for good. \n\nI came
    here to find out what happened, but I never expected to wake up in the middle
    of some alien trial. \n\nDon't worry, I'm getting you out of there. Whatever
    challenges this alien has prepared, we'll get through them together. Just keep
    guiding me, and I'll make it to you. I promise.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
  m_sharedMaterial: {fileID: 2140032, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
